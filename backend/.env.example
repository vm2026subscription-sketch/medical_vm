# --- Server ---
NODE_ENV=development
PORT=5000
# Leave empty for direct access. Use 1 only behind one trusted reverse proxy.
TRUST_PROXY=

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/medpath
# Optional: use 1.1.1.1,1.0.0.1 if Atlas SRV lookups fail with querySrv ECONNREFUSED.
# Leave blank to use your system DNS. This setting applies to this Node process.
DNS_SERVERS=

# --- JWT ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Redis (BullMQ jobs: slot-release, subscription-expiry, notifications) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same secret in Razorpay Dashboard webhook settings; required for checkout.
RAZORPAY_WEBHOOK_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# --- OTP provider: mock | msg91 | twilio ---
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Verify service must use six-digit codes.
TWILIO_VERIFY_SID=

# --- Email OTP provider: mock | smtp (use smtp for real email delivery) ---
EMAIL_OTP_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Use an address verified by your email provider.
SMTP_FROM="MedPath by Vidyarthi Mitra <verified-sender@example.com>"

# --- Cloudinary (college images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS ---
CORS_ORIGINS=https://medical.vidyarthimitra.org,http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Business rules ---
SLOT_HOLD_MINUTES=5
FREE_CUTOFF_ROWS=5
